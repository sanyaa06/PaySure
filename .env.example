# ==============================================================================
# PaySure Environment Configuration
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paysure_db

# Optional direct database connection string override:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paysure_db

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Platform runtime injection variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
